<style>
  :root {
    --bg: #07110e;
    --card: #0d1c17;
    --line: #1b3a30;
    --text: #e8f5ef;
    --muted: #9bb5aa;
    --accent: #3ddc97;
    --accent-ink: #052016;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
  }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
  header.nav {
    position: sticky; top: 0; z-index: 5;
    background: rgba(7,17,14,.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .logo { font-weight: 700; color: var(--text); text-decoration: none; }
  .nav a.cta {
    background: var(--accent); color: var(--accent-ink);
    padding: 8px 14px; border-radius: 999px; font-weight: 600; font-size: .9rem; text-decoration: none;
  }
  .hero { padding: 64px 0 40px; }
  .eyebrow { color: var(--accent); font-weight: 600; letter-spacing: .08em; font-size: .8rem; text-transform: uppercase; }
  h1 { font-size: clamp(2rem, 7vw, 3rem); line-height: 1.15; margin: 12px 0 16px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 560px; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .btn {
    display: inline-block; padding: 12px 20px; border-radius: 999px;
    font-weight: 600; text-decoration: none; border: 1px solid var(--line); color: var(--text);
  }
  .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  section { padding: 40px 0; border-top: 1px solid var(--line); }
  h2 { font-size: 1.5rem; margin: 0 0 20px; }
  .card {
    background: var(--card); border: 1px solid var(--line);
    border-radius: 16px; padding: 22px; margin-bottom: 18px;
  }
  .card h3 { margin: 0 0 6px; font-size: 1.2rem; }
  .tag { display: inline-block; font-size: .75rem; color: var(--accent); border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; margin: 0 6px 6px 0; }
  .card p { margin: 8px 0; color: var(--muted); }
  .card p strong { color: var(--text); }
  .card a.link { color: var(--accent); font-weight: 600; text-decoration: none; }
  .card a.link:hover { text-decoration: underline; }
  ul.steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  ul.steps li { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; color: var(--muted); }
  ul.steps li strong { color: var(--text); display: block; margin-bottom: 2px; }
  .services { display: grid; gap: 12px; padding: 0; list-style: none; margin: 0; }
  .services li { color: var(--muted); padding-left: 22px; position: relative; }
  .services li::before { content: ""; position: absolute; left: 0; top: .6em; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .contact { text-align: center; }
  .contact p { color: var(--muted); max-width: 480px; margin: 0 auto 20px; }
  footer { padding: 28px 0 40px; text-align: center; color: var(--muted); font-size: .85rem; border-top: 1px solid var(--line); }
  a:focus-visible, .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
</head>
